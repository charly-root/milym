{
  "name": "milym",
  "version": "1.0.0",
  "description": "milym — portfolio sombre, futuriste et minimaliste avec centre de contrôle.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build": "npm run build:css && npm run build:experience",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/output.css --watch",
    "build:experience": "vite build && rm -f public/experience/index.html",
    "watch:experience": "vite build --watch"
  },
  "author": "Charly",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@vitejs/plugin-react": "^6.0.5",
    "gsap": "^3.15.0",
    "nodemon": "^3.1.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.17",
    "three": "^0.185.1",
    "vite": "^8.2.1"
  }
}
