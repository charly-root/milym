<%- include('../partials/admin-header') %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold">Contacts</h1>
    <p class="mt-1 text-sm text-secondary">Blocs affichés sur la page contact du site</p>
  </div>
  <a href="/admin/contacts/nouveau" class="btn-primary btn-sm">+ Ajouter un contact</a>
</div>

<% if (contactList.length === 0) { %>
  <p class="mt-12 text-center text-secondary">Aucun contact pour le moment.</p>
<% } else { %>
  <div class="mt-8 flex flex-col gap-4">
    <% contactList.forEach(contact => { %>
      <div class="glass-card flex flex-col gap-4 p-5 sm:flex-row sm:items-center">
        <span class="badge shrink-0 uppercase tracking-widest"><%= contact.kind %></span>

        <div class="min-w-0 flex-1">
          <h2 class="font-semibold text-primary"><%= contact.label %></h2>
          <p class="mt-0.5 truncate text-sm text-secondary"><%= contact.value %></p>
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <a href="/admin/contacts/<%= contact.id %>/modifier" class="btn-ghost btn-sm">Modifier</a>
          <form method="POST" action="/admin/contacts/<%= contact.id %>/supprimer" data-confirm="Supprimer le contact « <%= contact.label %> » ?">
            <button type="submit" class="btn-danger btn-sm">Supprimer</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
