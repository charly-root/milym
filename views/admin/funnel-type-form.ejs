<%- include('../partials/admin-header') %>

<%
  const isNew = !type.id;
  const action = isNew ? "/admin/tunnel/types" : `/admin/tunnel/types/${type.id}`;
%>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold"><%= isNew ? "Nouveau type de projet" : "Modifier le type de projet" %></h1>
  <p class="mt-1 text-sm text-secondary">
    Chaque type est une carte de la première étape du tunnel. Son prix de base amorce l'estimation.
  </p>

  <% if (errors.length > 0) { %>
    <div class="mt-6 rounded-xl border border-red-500/40 bg-red-500/10 p-4" role="alert">
      <ul class="list-inside list-disc text-sm text-red-400">
        <% errors.forEach(error => { %><li><%= error %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= action %>" class="glass-card mt-6 flex flex-col gap-6 p-6 sm:p-8">
    <%- include('../partials/csrf') %>
    <div class="flex flex-col gap-2">
      <label for="label" class="field-label">Nom affiché</label>
      <input type="text" id="label" name="label" class="field" required maxlength="60" value="<%= type.label %>"
             placeholder="Site vitrine">
    </div>

    <div class="flex flex-col gap-2">
      <label for="tagline" class="field-label">Phrase d'accroche</label>
      <input type="text" id="tagline" name="tagline" class="field" maxlength="160" value="<%= type.tagline %>"
             placeholder="Présenter votre activité et être trouvé sur Google">
    </div>

    <fieldset class="flex flex-col gap-3">
      <legend class="field-label mb-1">Icône</legend>
      <%- include('../partials/admin-icon-picker', { name: 'icon', selected: type.icon }) %>
    </fieldset>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-2">
        <label for="basePrice" class="field-label">Prix de base (€ HT)</label>
        <input type="number" id="basePrice" name="basePrice" class="field" required min="0" max="500000" step="10"
               value="<%= type.basePrice %>">
        <p class="text-xs text-secondary/70">
          Point de départ avant les options. La fourchette affichée l'encadre selon les
          <a href="/admin/tunnel/reglages" class="text-purple-300 underline underline-offset-2">réglages tarifaires</a>.
        </p>
      </div>

      <div class="flex flex-col gap-2">
        <label for="position" class="field-label">Ordre d'affichage</label>
        <input type="number" id="position" name="position" class="field" min="0" max="999" step="1"
               value="<%= type.position %>">
        <p class="text-xs text-secondary/70">Le plus petit nombre s'affiche en premier.</p>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <label for="slug" class="field-label">
        Identifiant technique <span class="text-secondary">(facultatif)</span>
      </label>
      <input type="text" id="slug" name="slug" class="field" maxlength="80" value="<%= type.slug %>"
             placeholder="Généré depuis le nom">
      <p class="text-xs text-secondary/70">
        Sert à réserver des questions à ce type. Le modifier met à jour les questions concernées.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <button type="submit" class="btn-primary"><%= isNew ? "Créer le type" : "Enregistrer" %></button>
      <a href="/admin/tunnel" class="btn-ghost">Annuler</a>
    </div>
  </form>
</div>

<%- include('../partials/admin-footer') %>
