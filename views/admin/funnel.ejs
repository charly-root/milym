<%- include('../partials/admin-header') %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold">Tunnel « <%= settings.funnelTitle %> »</h1>
    <p class="mt-1 text-sm text-secondary">
      Types de projet, étapes, questions et tarifs du parcours de devis.
      Toute modification est immédiatement visible sur le site.
    </p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/admin/tunnel/reglages" class="btn-ghost btn-sm">Textes & tarifs</a>
    <a href="/creer-mon-projet" target="_blank" rel="noopener" class="btn-ghost btn-sm">Voir le tunnel</a>
  </div>
</div>

<!-- ── Types de projet ──────────────────────────────────────────────────── -->
<section class="mt-12">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold">Types de projet</h2>
      <p class="mt-1 text-sm text-secondary">
        Les grandes cartes de la première étape. Leur prix de base amorce l'estimation.
      </p>
    </div>
    <a href="/admin/tunnel/types/nouveau" class="btn-primary btn-sm">+ Ajouter un type</a>
  </div>

  <% if (types.length === 0) { %>
    <p class="mt-8 text-center text-secondary">Aucun type de projet : le tunnel ne peut pas démarrer.</p>
  <% } else { %>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <% types.forEach(type => { %>
        <div class="glass-card flex gap-4 p-5">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-purple-650/30 bg-purple-650/10 text-purple-300">
            <%- include('../partials/icon', { name: type.icon, classes: 'h-6 w-6' }) %>
          </span>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold text-primary"><%= type.label %></h3>
            <p class="mt-0.5 text-sm text-secondary"><%= type.tagline %></p>
            <p class="mt-2 text-xs uppercase tracking-widest text-purple-300">
              Base <%= euro(type.basePrice) %>
            </p>
            <div class="mt-4 flex flex-wrap items-center gap-2">
              <a href="/admin/tunnel/types/<%= type.id %>/modifier" class="btn-ghost btn-sm">Modifier</a>
              <form method="POST" action="/admin/tunnel/types/<%= type.id %>/supprimer"
                    data-confirm="Supprimer le type « <%= type.label %> » ? Les questions qui lui étaient réservées ne seront plus posées.">
                <%- include('../partials/csrf') %>
                <button type="submit" class="btn-danger btn-sm">Supprimer</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<!-- ── Étapes et questions ──────────────────────────────────────────────── -->
<section class="mt-14">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold">Étapes du questionnaire</h2>
      <p class="mt-1 text-sm text-secondary">
        La première étape accueille d'office le choix du type de projet.
        Une étape d'estimation est ajoutée à la fin du parcours.
      </p>
    </div>
    <a href="/admin/tunnel/etapes/nouvelle" class="btn-primary btn-sm">+ Ajouter une étape</a>
  </div>

  <div class="mt-6 flex flex-col gap-6">
    <% steps.forEach((step, index) => { %>
      <div class="glass-card p-5 sm:p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex min-w-0 gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-purple-500/40 bg-purple-650/20 text-sm font-semibold text-purple-200">
              <%= index + 1 %>
            </span>
            <div class="min-w-0">
              <h3 class="font-semibold text-primary"><%= step.title %></h3>
              <% if (step.description) { %>
                <p class="mt-0.5 text-sm text-secondary"><%= step.description %></p>
              <% } %>
              <p class="mt-1 text-xs text-secondary/70">
                Jalon : <%= step.shortLabel || "—" %> · <%= step.questions.length %> question<%= step.questions.length > 1 ? "s" : "" %>
                <% if (index === 0) { %> · choix du type de projet inclus<% } %>
              </p>
            </div>
          </div>
          <div class="flex shrink-0 flex-wrap items-center gap-2">
            <a href="/admin/tunnel/etapes/<%= step.id %>/modifier" class="btn-ghost btn-sm">Modifier</a>
            <% if (steps.length > 1) { %>
              <form method="POST" action="/admin/tunnel/etapes/<%= step.id %>/supprimer"
                    data-confirm="Supprimer l'étape « <%= step.title %> » et ses <%= step.questions.length %> question(s) ?">
                <%- include('../partials/csrf') %>
                <button type="submit" class="btn-danger btn-sm">Supprimer</button>
              </form>
            <% } %>
          </div>
        </div>

        <ul class="mt-5 flex flex-col gap-2.5 border-t border-purple-650/15 pt-5">
          <% step.questions.forEach(question => { %>
            <li class="flex flex-wrap items-center gap-3 rounded-xl border border-purple-650/15 bg-background/40 p-3.5">
              <div class="min-w-0 flex-1">
                <p class="text-sm text-primary">
                  <%= question.label %>
                  <% if (question.required) { %>
                    <span class="text-xs text-purple-300/80">(obligatoire)</span>
                  <% } %>
                </p>
                <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-secondary">
                  <span class="badge"><%= questionTypes[question.type] || question.type %></span>
                  <% if (question.options.length > 0) { %>
                    <span><%= question.options.length %> réponses</span>
                  <% } %>
                  <% if (question.showFor.length === 0) { %>
                    <span>posée à tous</span>
                  <% } else { %>
                    <span>réservée à <%= question.showFor.map(slug => typeLabels[slug] || slug).join(", ") %></span>
                  <% } %>
                </p>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <a href="/admin/tunnel/questions/<%= question.id %>/modifier" class="btn-ghost btn-sm">Modifier</a>
                <form method="POST" action="/admin/tunnel/questions/<%= question.id %>/supprimer"
                      data-confirm="Supprimer la question « <%= question.label %> » ?">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="btn-danger btn-sm">Supprimer</button>
                </form>
              </div>
            </li>
          <% }) %>

          <li>
            <a href="/admin/tunnel/questions/nouvelle?etape=<%= step.id %>"
               class="focus-ring flex items-center justify-center rounded-xl border border-dashed border-purple-650/30 p-3.5 text-sm text-secondary transition-colors hover:border-purple-500/50 hover:text-purple-300">
              + Ajouter une question à cette étape
            </a>
          </li>
        </ul>
      </div>
    <% }) %>
  </div>
</section>

<%- include('../partials/admin-footer') %>
