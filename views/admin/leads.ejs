<%- include('../partials/admin-header') %>

<div>
  <h1 class="text-2xl font-bold">Demandes de projet</h1>
  <p class="mt-1 text-sm text-secondary">
    <%= leads.length %> demande<%= leads.length > 1 ? 's' : '' %> via le tunnel « Créer mon projet »
  </p>
</div>

<% if (leads.length === 0) { %>
  <p class="mt-12 text-center text-secondary">Aucune demande pour le moment.</p>
<% } else { %>
  <div class="mt-8 flex flex-col gap-4">
    <% leads.forEach(lead => { %>
      <article class="glass-card p-6">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <div class="flex flex-wrap items-center gap-2.5">
              <h2 class="font-semibold text-primary"><%= lead.name %></h2>
              <span class="rounded-full bg-purple-650/15 px-3 py-1 text-xs text-purple-300">
                <%= typeLabels[lead.type] || lead.type %>
              </span>
            </div>
            <p class="mt-1 text-sm text-secondary">
              <a href="mailto:<%= lead.email %>" class="underline decoration-purple-650/50 underline-offset-2 transition-colors hover:text-purple-300 focus-ring rounded"><%= lead.email %></a>
              <% if (lead.phone) { %> — <%= lead.phone %><% } %>
              <% if (lead.company) { %> — <%= lead.company %><% } %>
            </p>
          </div>
          <div class="flex items-center gap-3">
            <time class="text-xs text-secondary/70" datetime="<%= lead.createdAt %>"><%= lead.createdAt %></time>
            <form method="POST" action="/admin/demandes/<%= lead.id %>/supprimer" data-confirm="Supprimer cette demande ?">
              <%- include('../partials/csrf') %>
              <button type="submit" class="btn-danger btn-sm">Supprimer</button>
            </form>
          </div>
        </div>

        <p class="mt-4 text-lg font-bold text-purple-300">
          <%= euro(lead.estimateMin) %> à <%= euro(lead.estimateMax) %>
          <% if (lead.monthlyMax > 0) { %>
            <span class="text-sm font-normal text-secondary">
              + <%= euro(lead.monthlyMin) %> à <%= euro(lead.monthlyMax) %> / mois
            </span>
          <% } %>
        </p>

        <% if (lead.details) { %>
          <p class="mt-4 whitespace-pre-line rounded-xl border border-purple-650/15 bg-background/40 p-4 text-sm leading-relaxed text-secondary"><%= lead.details %></p>
        <% } %>

        <details class="mt-4">
          <summary class="focus-ring cursor-pointer rounded text-sm text-purple-300">Détail du questionnaire</summary>
          <dl class="mt-3 flex flex-col divide-y divide-purple-650/15">
            <% lead.summary.forEach(line => { %>
              <div class="flex flex-wrap items-baseline justify-between gap-3 py-2 text-sm">
                <dt class="text-secondary"><%= line.label %></dt>
                <dd class="text-right text-primary"><%= line.value %></dd>
              </div>
            <% }) %>
          </dl>
        </details>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
