<%- include('../partials/admin-header') %>

<div>
  <h1 class="text-2xl font-bold">Messages reçus</h1>
  <p class="mt-1 text-sm text-secondary"><%= messages.length %> message<%= messages.length > 1 ? 's' : '' %> via le formulaire de contact</p>
</div>

<% if (messages.length === 0) { %>
  <p class="mt-12 text-center text-secondary">Aucun message pour le moment.</p>
<% } else { %>
  <div class="mt-8 flex flex-col gap-4">
    <% messages.forEach(msg => { %>
      <article class="glass-card p-6">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 class="font-semibold text-primary"><%= msg.subject %></h2>
            <p class="mt-1 text-sm text-secondary">
              De <span class="text-purple-300"><%= msg.name %></span>
              — <a href="mailto:<%= msg.email %>" class="underline decoration-purple-650/50 underline-offset-2 transition-colors hover:text-purple-300 focus-ring rounded"><%= msg.email %></a>
            </p>
          </div>
          <div class="flex items-center gap-3">
            <time class="text-xs text-secondary/70" datetime="<%= msg.createdAt %>"><%= msg.createdAt %></time>
            <form method="POST" action="/admin/messages/<%= msg.id %>/supprimer" data-confirm="Supprimer ce message ?">
              <button type="submit" class="btn-danger btn-sm">Supprimer</button>
            </form>
          </div>
        </div>
        <p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-secondary"><%= msg.message %></p>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
