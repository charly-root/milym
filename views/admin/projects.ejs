<%- include('../partials/admin-header') %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold">Projets</h1>
    <p class="mt-1 text-sm text-secondary"><%= projects.length %> projet<%= projects.length > 1 ? 's' : '' %> en ligne</p>
  </div>
  <a href="/admin/projets/nouveau" class="btn-primary btn-sm">+ Ajouter un projet</a>
</div>

<% if (projects.length === 0) { %>
  <p class="mt-12 text-center text-secondary">Aucun projet pour le moment. Ajoutez-en un pour commencer.</p>
<% } else { %>
  <div class="mt-8 flex flex-col gap-4">
    <% projects.forEach(project => { %>
      <div class="glass-card flex flex-col gap-4 p-5 sm:flex-row sm:items-center">
        <img src="<%= project.image || site.logo %>" alt="" class="h-16 w-24 shrink-0 rounded-lg border border-purple-650/20 object-cover" aria-hidden="true">

        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="font-semibold text-primary"><%= project.title %></h2>
            <span class="rounded-full bg-purple-650/15 px-2.5 py-0.5 text-xs text-purple-300"><%= project.category %></span>
          </div>
          <p class="mt-1 truncate text-sm text-secondary"><%= project.description %></p>
          <p class="mt-1 text-xs text-secondary/70"><%= project.technologies.join(' · ') %></p>
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <a href="/admin/projets/<%= project.id %>/modifier" class="btn-ghost btn-sm">Modifier</a>
          <form method="POST" action="/admin/projets/<%= project.id %>/supprimer" data-confirm="Supprimer le projet « <%= project.title %> » ?">
            <button type="submit" class="btn-danger btn-sm">Supprimer</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
