<%- include('partials/header') %>

<section class="relative mx-auto max-w-4xl px-5 pb-32 pt-36 sm:px-8">
  <div class="halo animate-pulse-halo left-1/2 top-64 h-[30rem] w-[30rem] -translate-x-1/2" aria-hidden="true"></div>

  <div class="materialize text-center">
    <h1 class="section-title">Contact</h1>
    <p class="mx-auto mt-5 max-w-xl leading-relaxed text-secondary">
      Une idée, un projet ou simplement envie d'échanger ? N'hésitez pas à me contacter.
    </p>
  </div>

  <!-- Panneau en verre contenant les informations (gérées depuis /admin/contacts) -->
  <div class="materialize glass-panel relative mt-14 p-6 sm:p-10">
    <div class="glass-shine" aria-hidden="true"></div>
    <div class="glass-edge-top" aria-hidden="true"></div>

    <div class="relative z-10 grid gap-4 sm:grid-cols-2">
      <% contacts.forEach(contact => { %>
        <% if (contact.kind === 'phone') { %>
          <a href="tel:<%= contact.value.replace(/[\s.]/g, '') %>" class="contact-block">
            <span class="contact-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/>
              </svg>
            </span>
            <span>
              <span class="block text-xs uppercase tracking-widest text-secondary"><%= contact.label %></span>
              <span class="block font-medium text-primary"><%= contact.value %></span>
            </span>
          </a>
        <% } else if (contact.kind === 'email') { %>
          <div class="contact-block">
            <span class="contact-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
              </svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-xs uppercase tracking-widest text-secondary"><%= contact.label %></span>
              <a href="mailto:<%= contact.value %>" class="block truncate font-medium text-primary transition-colors hover:text-purple-400 focus-ring rounded">
                <%= contact.value %>
              </a>
            </span>
            <button type="button" class="copy-email focus-ring shrink-0 rounded-lg border border-purple-650/30 p-2 text-secondary transition-all hover:border-purple-500/60 hover:text-purple-400"
                    data-email="<%= contact.value %>" aria-label="Copier l'adresse e-mail">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75"/>
              </svg>
            </button>
          </div>
        <% } else { %>
          <a href="<%= contact.value %>" target="_blank" rel="noopener noreferrer" class="contact-block">
            <span class="contact-icon" aria-hidden="true">
              <% if (contact.kind === 'github') { %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                  <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.27 5.68.41.35.77 1.05.77 2.12v3.14c0 .3.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
                </svg>
              <% } else if (contact.kind === 'linkedin') { %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/>
                </svg>
              <% } else { %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/>
                </svg>
              <% } %>
            </span>
            <span class="min-w-0">
              <span class="block text-xs uppercase tracking-widest text-secondary"><%= contact.label %></span>
              <span class="block truncate font-medium text-primary"><%= contact.value.replace(/^https?:\/\//, '') %></span>
            </span>
          </a>
        <% } %>
      <% }) %>
    </div>
  </div>

  <!-- Formulaire de contact -->
  <div class="materialize glass-panel relative mt-10 p-6 sm:p-10">
    <div class="glass-edge-top" aria-hidden="true"></div>

    <h2 class="relative z-10 text-xl font-semibold text-primary">Envoyez-moi un message</h2>

    <form id="contact-form" method="POST" action="/contact" class="relative z-10 mt-8 grid gap-6 sm:grid-cols-2" novalidate>
      <div class="flex flex-col gap-2">
        <label for="name" class="field-label">Nom</label>
        <input type="text" id="name" name="name" class="field" required minlength="2" maxlength="100"
               autocomplete="name" placeholder="Votre nom">
        <p class="field-error" data-error-for="name" hidden></p>
      </div>

      <div class="flex flex-col gap-2">
        <label for="email" class="field-label">Adresse e-mail</label>
        <input type="email" id="email" name="email" class="field" required maxlength="254"
               autocomplete="email" placeholder="vous@exemple.com">
        <p class="field-error" data-error-for="email" hidden></p>
      </div>

      <div class="flex flex-col gap-2 sm:col-span-2">
        <label for="subject" class="field-label">Sujet</label>
        <input type="text" id="subject" name="subject" class="field" required minlength="3" maxlength="150"
               placeholder="L'objet de votre message">
        <p class="field-error" data-error-for="subject" hidden></p>
      </div>

      <div class="flex flex-col gap-2 sm:col-span-2">
        <label for="message" class="field-label">Message</label>
        <textarea id="message" name="message" rows="6" class="field resize-y" required minlength="10" maxlength="3000"
                  placeholder="Décrivez votre projet ou votre demande..."></textarea>
        <p class="field-error" data-error-for="message" hidden></p>
      </div>

      <p class="field-error sm:col-span-2" data-error-for="global" hidden></p>

      <div class="sm:col-span-2">
        <button type="submit" class="btn-primary w-full sm:w-auto">Envoyer</button>
      </div>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
