<%- include('partials/header') %>

<div id="story-progress" class="story-progress" aria-hidden="true"></div>

<article id="home-story" class="home-story">
  <div id="home-story-track" class="home-story-track">
    <div class="home-story-sticky">
      <div
        id="milym-experience"
        class="home-canvas"
        data-logo="<%= site.logo %>"
        data-site-name="<%= site.name %>"
        aria-hidden="true"
      ></div>

      <!-- Le flash qui couvre le raccord entre la France vue du ciel et le bureau -->
      <div id="story-flash" class="story-flash" aria-hidden="true"></div>

      <!-- Repère de lecture : où en est-on dans la fabrication du projet -->
      <ol class="story-rail" aria-label="Chapitres du récit">
        <% [
          ['earth','Espace'],
          ['idea','Idée'],
          ['sketch','Croquis'],
          ['interface','Interface'],
          ['factory','Frontend'],
          ['backend','Backend'],
          ['data','Données'],
          ['ai','IA'],
          ['core','Digital Core'],
          ['ecosystem','Écosystème'],
          ['final','Produit']
        ].forEach(([id, label], i) => { %>
          <li class="story-rail-step" data-rail-step="<%= i %>" data-snap="<%= id %>">
            <span class="story-rail-mark"></span>
            <span class="story-rail-label"><%= label %></span>
          </li>
        <% }) %>
      </ol>

      <div class="home-story-copy">
        <section class="story-chapter" data-chapter="earth">
          <p class="story-kicker">00 — Depuis l’espace</p>
          <h1 class="story-title">Créateur de projets numériques</h1>
          <p class="story-lead">La nuit, chaque lumière est un projet qui veille. Le prochain, né en France, va tout faire exploser.</p>
        </section>

        <section class="story-chapter" data-chapter="idea">
          <p class="story-kicker">01 — L’idée</p>
          <h2 class="story-title">Tout commence par une idée.</h2>
          <p class="story-lead">Griffonnée sur un coin de table, un soir, à la lumière d’une lampe.</p>
        </section>

        <section class="story-chapter" data-chapter="sketch">
          <p class="story-kicker">02 — Le croquis</p>
          <h2 class="story-title story-title-md">Même griffonnée sur un coin de table.</h2>
          <p class="story-lead">Les blocs dessinés se détachent de la feuille : un bandeau, un titre, un bouton, deux cartes.</p>
        </section>

        <section class="story-chapter story-chapter-bridge" data-chapter="wireframe">
          <p class="story-kicker">03 — Le wireframe</p>
          <h2 class="story-title story-title-md">On lui donne une forme.</h2>
          <p class="story-lead">Les traits se redressent, les annotations s’effacent, la feuille devient un écran.</p>
        </section>

        <section class="story-chapter story-chapter-bridge" data-chapter="prototype">
          <p class="story-kicker">04 — Le prototype</p>
          <h2 class="story-title story-title-md">Puis une interface.</h2>
          <p class="story-lead">Blocs gris et textes provisoires : la structure tient, le reste viendra.</p>
        </section>

        <section class="story-chapter" data-chapter="interface">
          <p class="story-kicker">03 — L’interface</p>
          <h2 class="story-title story-title-md">Le produit prend son visage.</h2>
          <p class="story-lead">Composants finis, contenus réels, images en place.</p>
        </section>

        <section class="story-chapter" data-chapter="factory">
          <p class="story-kicker">04 — Le frontend</p>
          <h2 class="story-title story-title-md">Puis une logique.</h2>
          <p class="story-lead">L’écran s’ouvre en couches : UI, React, état, API, Node.js, base de données.</p>
        </section>

        <section class="story-chapter" data-chapter="backend">
          <p class="story-kicker">05 — Le backend</p>
          <h2 class="story-title story-title-md">Une interface n’est que le début.</h2>
          <p class="story-lead">Nous construisons aussi ce qu’il y a derrière : passerelle, serveur, services.</p>
        </section>

        <section class="story-chapter" data-chapter="data">
          <p class="story-kicker">06 — Les données</p>
          <h2 class="story-title story-title-md">Les données se rangent.</h2>
          <p class="story-lead">Lignes d’une table, disques d’une base : la requête s’écrit, puis se relit.</p>
        </section>

        <section class="story-chapter" data-chapter="ai">
          <p class="story-kicker">07 — L’intelligence</p>
          <h2 class="story-title story-title-md">Le modèle s’allume.</h2>
          <p class="story-lead">Une impulsion traverse les données et le réseau s’ouvre, nœud après nœud.</p>
        </section>

        <section class="story-chapter" data-chapter="core">
          <p class="story-kicker">08 — Digital Core</p>
          <h2 class="story-title story-title-md">Tout se rassemble.</h2>
          <p class="story-lead">Le réseau se referme : l’idée devient un produit, un noyau de technologies.</p>
        </section>

        <section class="story-chapter story-chapter-ecosystem" data-chapter="ecosystem">
          <p class="story-kicker">09 — L’écosystème</p>
          <h2 class="story-title story-title-md">L’écosystème Milym</h2>
          <p class="story-lead">Sites, applications, intelligence artificielle, backend, données, automatisation.</p>
          <nav class="story-ecosystem-nav" aria-label="Domaines d’intervention">
            <a href="/projets#sites-web">Sites web</a>
            <a href="/projets#applications">Applications</a>
            <a href="/projets#intelligence-artificielle">Intelligence artificielle</a>
            <a href="/projets">Backend &amp; données</a>
            <a href="/projets#outils">Automatisation</a>
          </nav>
        </section>

        <section class="story-chapter story-chapter-final" data-chapter="final">
          <p class="story-kicker">10 — Le produit</p>
          <h2 class="story-title">Une idée peut devenir beaucoup de choses.</h2>
          <p class="story-lead">Parlons de la vôtre.</p>
          <p class="sr-only"><%= settings.heroTitle %>. <%= settings.heroSubtitle %></p>
          <div class="story-cta">
            <a href="/creer-mon-projet" class="btn-primary"><%= settings.funnelCtaLabel %></a>
            <a href="/projets" class="btn-ghost">Voir mes projets</a>
            <a href="/contact" class="btn-ghost">Me contacter</a>
          </div>
        </section>
      </div>

      <p id="story-hint" class="story-hint" aria-hidden="true">Faites défiler</p>
    </div>
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "<%= site.name %>",
  "description": "<%= settings.heroSubtitle %>",
  "url": "/",
  "image": "/logos/milym-wordmark.png",
  "areaServed": "FR",
  "knowsAbout": ["Sites web", "Applications web", "Intelligence artificielle", "API", "Backend", "Automatisation"]
}
</script>

<section id="a-propos" class="relative mx-auto max-w-6xl px-5 pb-32 pt-16 sm:px-8">
  <div class="materialize mx-auto max-w-3xl text-center">
    <h2 class="section-title">À propos</h2>
    <p class="mt-6 leading-relaxed text-secondary"><%= settings.aboutText %></p>
  </div>

  <div class="mt-14 grid gap-6 sm:grid-cols-3">
    <% [1, 2, 3].forEach(i => { %>
      <div class="materialize glass-card p-8 text-center">
        <p class="text-3xl font-bold text-purple-400"><%= settings['stat' + i + 'Value'] %></p>
        <p class="mt-2 text-sm text-secondary"><%= settings['stat' + i + 'Label'] %></p>
      </div>
    <% }) %>
  </div>

  <div class="materialize mt-14 flex flex-wrap justify-center gap-3">
    <a href="/creer-mon-projet" class="btn-primary"><%= settings.funnelCtaLabel %></a>
    <a href="/projets" class="btn-ghost">Découvrir mes projets</a>
  </div>
</section>

<script type="module" src="/experience/experience.js"></script>

<%- include('partials/footer') %>
