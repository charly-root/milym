<%
  // Rend une question du tunnel depuis sa définition (voir lib/funnel.js).
  const previous = values[q.key];
  const isChecked = (v) => (Array.isArray(previous) ? previous.includes(v) : previous === v);
  const error = errors[q.key];
  const showFor = q.showFor.join(" ");
  const cfg = q.config;
%>

<div class="funnel-question"
     data-question="<%= q.key %>"
     <% if (showFor) { %>data-show-for="<%= showFor %>"<% } %>
     <% if (q.required) { %>data-required<% } %>>

  <% if (q.type === "cards") { %>
    <fieldset>
      <legend class="sr-only"><%= q.label %></legend>
      <div class="grid gap-4 sm:grid-cols-2">
        <% q.options.forEach(o => { %>
          <label class="funnel-card">
            <input type="radio" name="<%= q.key %>" value="<%= o.value %>" class="sr-only"
                   data-label="<%= o.label %>"
                   <%= isChecked(o.value) ? "checked" : "" %>>
            <span class="funnel-card-icon"><%- include('icon', { name: o.icon, classes: 'h-7 w-7' }) %></span>
            <span class="funnel-card-mark" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="h-4 w-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
              </svg>
            </span>
            <span class="funnel-card-title"><%= o.label %></span>
            <% if (o.help) { %><span class="funnel-card-help"><%= o.help %></span><% } %>
          </label>
        <% }) %>
      </div>
    </fieldset>

  <% } else if (q.type === "radio" || q.type === "checkbox") { %>
    <fieldset>
      <legend class="funnel-legend">
        <%= q.label %>
        <% if (q.type === "checkbox") { %>
          <span class="text-xs font-normal text-secondary">(plusieurs choix possibles)</span>
        <% } %>
      </legend>
      <% if (q.help) { %><p class="funnel-help"><%= q.help %></p><% } %>
      <div class="mt-4 grid gap-3 <%= q.options.length > 4 ? 'sm:grid-cols-2' : '' %>">
        <% q.options.forEach(o => { %>
          <label class="funnel-option">
            <input type="<%= q.type %>" name="<%= q.key %>" value="<%= o.value %>" class="sr-only"
                   data-label="<%= o.label %>"
                   <%= isChecked(o.value) ? "checked" : "" %>>
            <span class="funnel-option-icon" aria-hidden="true"><%- include('icon', { name: o.icon, classes: 'h-5 w-5' }) %></span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm text-primary"><%= o.label %></span>
              <% if (o.help) { %><span class="mt-0.5 block text-xs text-secondary"><%= o.help %></span><% } %>
            </span>
            <span class="funnel-option-mark" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3.5" stroke="currentColor" class="h-3 w-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
              </svg>
            </span>
          </label>
        <% }) %>
      </div>
    </fieldset>

  <% } else if (q.type === "number") { %>
    <label class="funnel-legend block" for="q-<%= q.key %>"><%= q.label %></label>
    <% if (q.help) { %><p class="funnel-help"><%= q.help %></p><% } %>
    <div class="funnel-stepper mt-4" data-stepper>
      <button type="button" class="funnel-stepper-btn" data-step-down aria-label="Diminuer">&minus;</button>
      <input type="number" id="q-<%= q.key %>" name="<%= q.key %>"
             min="<%= cfg.min || 0 %>" max="<%= cfg.max || 999 %>" step="1"
             value="<%= previous === undefined ? (cfg.default || cfg.min || 0) : previous %>">
      <button type="button" class="funnel-stepper-btn" data-step-up aria-label="Augmenter">+</button>
    </div>

  <% } else if (q.type === "textarea") { %>
    <label class="funnel-legend block" for="q-<%= q.key %>">
      <%= q.label %><% if (!q.required) { %> <span class="text-xs font-normal text-secondary">(facultatif)</span><% } %>
    </label>
    <% if (q.help) { %><p class="funnel-help"><%= q.help %></p><% } %>
    <textarea id="q-<%= q.key %>" name="<%= q.key %>" rows="5" class="field mt-4 resize-y"
              maxlength="<%= cfg.maxLength || 3000 %>"><%= previous || "" %></textarea>

  <% } else { %>
    <label class="funnel-legend block" for="q-<%= q.key %>">
      <%= q.label %><% if (!q.required) { %> <span class="text-xs font-normal text-secondary">(facultatif)</span><% } %>
    </label>
    <% if (q.help) { %><p class="funnel-help"><%= q.help %></p><% } %>
    <input type="<%= q.type %>" id="q-<%= q.key %>" name="<%= q.key %>" class="field mt-3"
           maxlength="<%= cfg.maxLength || 200 %>" value="<%= previous || "" %>"
           <% if (q.type === "email") { %>autocomplete="email"<% } %>
           <% if (q.type === "tel") { %>autocomplete="tel"<% } %>>
  <% } %>

  <p class="field-error mt-2" data-error-for="<%= q.key %>" <%= error ? "" : "hidden" %>><%= error || "" %></p>
</div>
