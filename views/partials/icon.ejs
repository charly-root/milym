<%
  // Affiche une icône du jeu défini dans lib/icons.js.
  // Paramètres : name (clé de l'icône), classes (facultatif, classes CSS).
  const paths = iconPaths(name);
%><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="<%= typeof classes === "undefined" ? "h-6 w-6" : classes %>" aria-hidden="true"><% paths.forEach(d => { %><path stroke-linecap="round" stroke-linejoin="round" d="<%= d %>"/><% }) %></svg>
