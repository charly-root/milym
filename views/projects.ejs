<%- include('partials/header') %>

<section class="mx-auto max-w-6xl px-5 pb-32 pt-36 sm:px-8">
  <div class="materialize text-center">
    <h1 class="section-title">Mes projets</h1>
    <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-secondary">
      Découvrez une sélection de projets que j'ai imaginés, développés et améliorés au fil du temps.
    </p>
  </div>

  <!-- Filtres par catégorie -->
  <div class="materialize mt-12 flex flex-wrap items-center justify-center gap-3" role="group" aria-label="Filtrer les projets par catégorie">
    <% categories.forEach((category, i) => { %>
      <button type="button"
              class="filter-btn <%= i === 0 ? 'filter-btn-active' : '' %>"
              data-filter="<%= category %>"
              data-slug="<%= category.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') %>"
              aria-pressed="<%= i === 0 ? 'true' : 'false' %>">
        <%= category %>
      </button>
    <% }) %>
  </div>

  <!-- Grille de projets -->
  <div id="projects-grid" class="mt-14 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
    <% projects.forEach(project => { %>
      <article class="project-card materialize" data-category="<%= project.category %>">
        <div class="overflow-hidden rounded-t-2xl">
          <img src="<%= project.image %>"
               alt="Aperçu du projet <%= project.title %>"
               class="project-image"
               loading="lazy"
               width="640" height="400">
        </div>

        <div class="flex flex-1 flex-col gap-4 p-6">
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-lg font-semibold text-primary"><%= project.title %></h2>
            <span class="shrink-0 rounded-full bg-purple-650/15 px-3 py-1 text-xs text-purple-300"><%= project.category %></span>
          </div>

          <p class="text-sm leading-relaxed text-secondary"><%= project.description %></p>

          <ul class="flex flex-wrap gap-2" aria-label="Technologies utilisées">
            <% project.technologies.forEach(tech => { %>
              <li class="badge"><%= tech %></li>
            <% }) %>
          </ul>

          <div class="mt-auto flex flex-wrap gap-3 pt-2">
            <a href="<%= project.projectUrl %>" target="_blank" rel="noopener noreferrer" class="btn-primary btn-sm">
              Voir le projet
            </a>
            <% if (project.githubUrl) { %>
              <a href="<%= project.githubUrl %>" target="_blank" rel="noopener noreferrer" class="btn-ghost btn-sm">
                Code source
              </a>
            <% } %>
          </div>
        </div>
      </article>
    <% }) %>
  </div>

  <!-- Message si aucun projet ne correspond au filtre -->
  <p id="no-projects" class="mt-16 text-center text-secondary" hidden>
    Aucun projet ne correspond à cette catégorie pour le moment.
  </p>
</section>

<%- include('partials/footer') %>
