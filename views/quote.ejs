<%- include('partials/header') %>

<%
  // Page servie quand le questionnaire est envoyé sans JavaScript : le parcours
  // guidé affiche le même contenu directement dans la dernière étape.
  const weekLabel = quote.weeks[0] === quote.weeks[1]
    ? `${quote.weeks[0]} semaines`
    : `${quote.weeks[0]} à ${quote.weeks[1]} semaines`;
%>

<section class="relative mx-auto max-w-3xl px-5 pb-32 pt-36 sm:px-8">
  <div class="halo animate-pulse-halo left-1/2 top-40 h-[30rem] w-[30rem] -translate-x-1/2" aria-hidden="true"></div>

  <div class="materialize text-center">
    <h1 class="section-title"><%= settings.funnelResultTitle %></h1>
    <p class="mx-auto mt-5 max-w-xl leading-relaxed text-secondary"><%= settings.funnelResultIntro %></p>
  </div>

  <div class="materialize glass-panel relative mt-14 p-6 sm:p-10">
    <div class="glass-edge-top" aria-hidden="true"></div>

    <div class="relative z-10">
      <p class="text-xs uppercase tracking-widest text-secondary">Budget de réalisation</p>
      <p class="mt-2 text-3xl font-bold text-purple-300 sm:text-4xl">
        <%= euro(quote.min) %> à <%= euro(quote.max) %>
      </p>
      <p class="mt-1 text-xs text-secondary">Montants hors taxes, à affiner ensemble.</p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-purple-650/20 bg-background/40 p-4">
          <dt class="text-xs uppercase tracking-widest text-secondary">Délai estimé</dt>
          <dd class="mt-1 font-semibold text-primary"><%= weekLabel %></dd>
        </div>
        <div class="rounded-xl border border-purple-650/20 bg-background/40 p-4">
          <dt class="text-xs uppercase tracking-widest text-secondary">Maintenance</dt>
          <dd class="mt-1 font-semibold text-primary">
            <% if (quote.monthly[1] > 0) { %>
              <%= euro(quote.monthly[0]) %> à <%= euro(quote.monthly[1]) %> / mois
            <% } else { %>
              Aucune
            <% } %>
          </dd>
        </div>
      </dl>

      <h2 class="mt-8 text-sm font-semibold text-primary">Ce qui compose ce montant</h2>
      <ul class="mt-3 flex flex-col divide-y divide-purple-650/15">
        <% quote.breakdown.forEach(line => { %>
          <li class="flex items-baseline justify-between gap-4 py-2.5 text-sm">
            <span class="text-secondary"><%= line.label %></span>
            <span class="shrink-0 text-primary"><%= euro(line.min) %> à <%= euro(line.max) %></span>
          </li>
        <% }) %>
      </ul>

      <% if (quote.factor > 1) { %>
        <p class="mt-4 text-xs text-secondary">
          Un coefficient de <%= quote.factor %> a été appliqué au total
          (nombre d'utilisateurs et délai souhaité).
        </p>
      <% } %>

      <p class="mt-8 text-xs leading-relaxed text-secondary"><%= settings.funnelDisclaimer %></p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/projets" class="btn-primary">Voir mes réalisations</a>
        <a href="/" class="btn-ghost">Retour à l'accueil</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
